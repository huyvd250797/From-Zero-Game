{
  "name": "from-zero",
  "version": "3.21.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "preview": "node scripts/serve.mjs dist",
    "check": "node scripts/check.mjs",
    "data:validate": "node scripts/master-data.mjs",
    "predev": "npm run data:validate",
    "pretest": "npm run data:validate",
    "simulate:balance": "node scripts/simulate-balance.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "benchmark:navigation": "node scripts/benchmark-navigation.mjs",
    "smoke:http": "node scripts/smoke-http.mjs",
    "release:check": "npm ci && npm test && npm run build && npm run verify:release && npm run smoke:http && npm run simulate:balance && npm run simulate:long-term",
    "test:three": "node --test tests/three-runtime.integration.mjs",
    "build:native-preview": "node scripts/build.mjs --native-preview",
    "benchmark:npc": "node scripts/benchmark-npc.mjs",
    "simulate:long-term": "node scripts/simulate-long-term.mjs",
    "vehicle:import": "node scripts/import-professional-vehicle.mjs",
    "vehicle:verify": "node scripts/verify-professional-vehicles.mjs",
    "vehicle:prepare": "node scripts/modeling/prepare-vehicle.mjs",
    "vehicle:publish": "node scripts/modeling/publish-vehicle.mjs",
    "benchmark:vehicles": "node scripts/benchmark-vehicles.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "three": "0.180.0"
  }
}
